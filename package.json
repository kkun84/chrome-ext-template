{
  "name": "chrome-ext-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^24",
    "pnpm": "^10.34.6"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "fallow": "fallow dead-code && fallow architecture && fallow dupes && fallow health --score --complexity",
    "fallow:audit": "fallow audit --base origin/main",
    "settings:check": "bash scripts/github-settings.sh --check",
    "settings:apply": "bash scripts/github-settings.sh --apply",
    "dedupe:check": "pnpm dedupe --check",
    "audit": "pnpm audit --audit-level moderate",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm fallow",
    "check:all": "pnpm check && pnpm test:coverage && pnpm build && pnpm test:e2e && pnpm dedupe:check && pnpm audit",
    "clean": "rm -rf .output .wxt coverage playwright-report test-results",
    "prepare": "sh -c 'if [ -d .git ]; then lefthook install; else echo \"skipping lefthook install: no .git directory\"; fi'"
  },
  "dependencies": {
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.59.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "fallow": "3.38.1",
    "lefthook": "2.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.1.0",
    "wxt": "0.21.5"
  }
}
