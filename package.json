{
  "name": "chrome-ext-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "effect": "4.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.59.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "^5.1.0",
    "wxt": "0.21.5"
  }
}
